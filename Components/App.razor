@* Components/App.razor *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using VaxSync.Web.Components.Account.Shared
@using VaxSync.Web.Components.Layout
@using MudBlazor
@using System.Security.Claims

@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>

    <MudThemeProvider Theme="@AppTheme.Theme" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <!-- ✅ Cascading Authentication State -->
    <CascadingAuthenticationState>
        <AuthorizeView>
            <Authorized Context="authState">
                @{
                    var user = authState.User;
                    var uri = new Uri(Navigation.Uri).AbsolutePath;

                    if (user.Identity?.IsAuthenticated == true)
                    {
                        // ✅ Role-based redirect (only if not already there)
                        if (user.IsInRole("Admin") && !uri.StartsWith("/admin-dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            Navigation.NavigateTo("/admin-dashboard", true);
                        }
                        else if (user.IsInRole("SchoolNurse") && !uri.StartsWith("/nurse-dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            Navigation.NavigateTo("/nurse-dashboard", true);
                        }
                        else if (user.IsInRole("Viewer") && !uri.StartsWith("/viewer-dashboard", StringComparison.OrdinalIgnoreCase))
                        {
                            Navigation.NavigateTo("/viewer-dashboard", true);
                        }
                    }
                }

                <!-- ✅ Router for logged-in users -->
                <Router AppAssembly="@typeof(Program).Assembly">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                            <NotAuthorized>
                                <LayoutView Layout="typeof(MainLayout)">
                                    <MudAlert Severity="Severity.Warning" Class="m-4">
                                        You are not authorized to view this page.
                                    </MudAlert>
                                </LayoutView>
                            </NotAuthorized>
                            <Authorizing>
                                <LayoutView Layout="typeof(MainLayout)">
                                    <MudProgressCircular Indeterminate="true"
                                                         Color="Color.Primary"
                                                         Size="Size.Large"
                                                         Class="m-6" />
                                </LayoutView>
                            </Authorizing>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="routeData" Selector="h1" />
                    </Found>
                    <NotFound>
                        <LayoutView Layout="typeof(MainLayout)">
                            <MudAlert Severity="Severity.Error" Class="m-4">
                                Sorry, the page could not be found.
                            </MudAlert>
                        </LayoutView>
                    </NotFound>
                </Router>
            </Authorized>

            <NotAuthorized>
                <!-- ✅ Router for guests (Login, Register, etc.) -->
                <Router AppAssembly="@typeof(Program).Assembly">
                    <Found Context="routeData">
                        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                    </Found>
                    <NotFound>
                        <LayoutView Layout="typeof(MainLayout)">
                            <MudAlert Severity="Severity.Error" Class="m-4">
                                Sorry, the page could not be found.
                            </MudAlert>
                        </LayoutView>
                    </NotFound>
                </Router>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
