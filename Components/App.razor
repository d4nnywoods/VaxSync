@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<CascadingAuthenticationState>
    <MudThemeProvider />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <Router AppAssembly="@typeof(App).Assembly" PreferExactMatches="true">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(VaxSync.Web.Components.Layout.MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(VaxSync.Web.Components.Layout.MainLayout)">
                <MudAlert Severity="Severity.Error" Elevation="0">
                    Sorry, there's nothing at this address.
                </MudAlert>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
